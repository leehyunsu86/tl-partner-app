# 이 파일을 복사해서 .env.local 로 이름 바꾸고 실제 값을 채워넣으세요.
# .env.local 파일은 절대 GitHub에 올리지 마세요 (.gitignore에 이미 등록되어 있어요)

# Supabase 프로젝트 Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://gchcppoehhlawjqgjhnc.supabase.co

# Publishable key (공개되어도 안전한 키, 지금은 사용 안 하지만 추후 확장용으로 남겨둠)
NEXT_PUBLIC_SUPABASE_ANON_KEY=여기에_publishable_key_붙여넣기

# ⚠️ Secret key - 반드시 이 파일(.env.local) 또는 Vercel 환경변수에만 입력하세요.
# 채팅이나 코드 저장소에 절대 붙여넣지 마세요.
SUPABASE_SERVICE_ROLE_KEY=여기에_secret_key_붙여넣기
